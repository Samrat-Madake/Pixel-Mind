**Index Worker Flow:**
```python
async def process_image(path: Path, sse_queue: asyncio.Queue):
    try:
        sha256 = compute_sha256(path)
        if db.is_indexed(sha256): return   # Skip

        img = Image.open(path).convert("RGB")

        # Parallel-ish (sequential on CPU to avoid memory spikes)
        clip_vec   = clip_pipeline.encode_image(img)        # 512-D
        exif_data  = exif_pipeline.extract(path)            # dict
        phash_str  = dedup_pipeline.compute_phash(img)      # hex str
        faces      = face_pipeline.detect_faces(img)        # list

        image_id = db.insert_image(path, sha256, phash_str, img.size)
        db.insert_metadata(image_id, exif_data)

        faiss_id = faiss_store.add(clip_vec, image_id)
        db.insert_embedding_map(image_id, faiss_id)

        dedup_pipeline.check_and_register(image_id, phash_str)

        for face in faces:
            embedding  = face_pipeline.embed_face(face["crop"])
            cluster_id = face_pipeline.assign_cluster(embedding)
            db.insert_face(image_id, face["bbox"], cluster_id, face["conf"])

        graph_manager.update(image_id, cluster_ids_in_image)

        await sse_queue.put({"status": "indexed", "path": str(path)})

    except Exception as e:
        await sse_queue.put({"status": "error", "path": str(path), "error": str(e)})
```

